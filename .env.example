# Copy to .env in the project root for Docker Compose variable substitution.
# Application settings (INK_API_BASE, INK_TOKEN, weather, etc.) belong in
# server/.env instead; start by copying server/.env.example there as well.

# Dedicated host photo directory, mounted at /ink-backgrounds in containers.
# Relative paths resolve from the Compose project directory.
# The initialization container sets this directory's owner to UID 10001.
INK_BACKGROUND_HOST_DIR=./server/ink-backgrounds

# Existing Compose options; change only if your host uses different values.
HTTP_PROXY_PORT=7890
CUPS_PRINTER=HP_DeskJet_2700_series_CB7F78
