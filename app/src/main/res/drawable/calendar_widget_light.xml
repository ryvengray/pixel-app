<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#B8F9FFF8" android:endColor="#99E4F0E6" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#50FFFFFF" android:centerColor="#14FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
