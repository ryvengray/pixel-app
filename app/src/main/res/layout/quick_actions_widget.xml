<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/quick_chat_widget_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="GRETA · 快捷面板" android:textSize="12sp" android:textColor="#6D8576" />
<TextView android:id="@+id/quick_customize" android:layout_width="72dp" android:layout_height="match_parent" android:gravity="center" android:text="自定义" android:textSize="12sp" android:textColor="#234D3B" android:contentDescription="自定义六个快捷功能" />
</LinearLayout>
<TextView android:id="@+id/quick_chat" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="48dp" android:gravity="center_vertical" android:text="说吧，我在听  ↗" android:textColor="#234D3B" android:textSize="22sp" android:textStyle="bold" android:contentDescription="开始和 Greta 语音对话" />
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal">
<TextView android:id="@+id/action_slot_0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="语音记事" android:textColor="#234D3B" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" android:background="@drawable/quick_chat_widget_action" />
<TextView android:id="@+id/action_slot_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:text="添加提醒" android:textColor="#234D3B" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" android:background="@drawable/quick_chat_widget_action" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal">
<TextView android:id="@+id/action_slot_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="写一条" android:textColor="#234D3B" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" android:background="@drawable/quick_chat_widget_action" />
<TextView android:id="@+id/action_slot_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:text="日历" android:textColor="#234D3B" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" android:background="@drawable/quick_chat_widget_action" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal">
<TextView android:id="@+id/action_slot_4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="新闻订阅" android:textColor="#234D3B" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" android:background="@drawable/quick_chat_widget_action" />
<TextView android:id="@+id/action_slot_5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:text="数学冒险岛" android:textColor="#234D3B" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" android:background="@drawable/quick_chat_widget_action" />
</LinearLayout>
</LinearLayout>
