<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <queries><package android:name="com.termux" /><intent><action android:name="android.speech.RecognitionService" /></intent></queries>
    <application android:name=".GretaApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustNothing">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <activity android:name=".CalendarActivity" android:exported="false" />
        <activity android:name=".CalendarWidgetSettingsActivity" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <receiver android:name=".CalendarUpdates" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/><action android:name="android.intent.action.TIME_SET"/><action android:name="android.intent.action.TIMEZONE_CHANGED"/><action android:name="android.intent.action.MY_PACKAGE_REPLACED"/></intent-filter>
        </receiver>
        <receiver android:name=".CalendarWidget" android:label="日历 · 大月历" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/calendar_widget"/></receiver>
        <receiver android:name=".CalendarWidget$Agenda" android:label="日历 · 近期日期" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/agenda_widget"/></receiver>
        <receiver android:name=".CalendarWidget$Countdown" android:label="日历 · 单个纪念日" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/countdown_widget"/></receiver>
        <activity android:name=".ImageRecordActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <provider android:name=".LifeImageProvider" android:authorities="${applicationId}.images" android:exported="false" android:grantUriPermissions="true" />
        <service android:name=".LifeSync" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <activity android:name=".RecordsActivity" android:exported="false" android:theme="@style/ToolDrawerLight" />
        <activity android:name=".TopicsActivity" android:exported="false" android:theme="@style/ToolDrawerLight" />
        <activity android:name=".HistoryActivity" android:exported="false" />
        <activity android:name=".MemoryActivity" android:exported="false" />
        <activity android:name=".AssistantSettingsActivity" android:exported="false" />
        <service android:name=".GretaFirebaseMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver android:name=".ResultReceiver" android:exported="false" />
        <activity android:name=".SyncActivity" android:exported="false" android:theme="@style/ToolDrawerLight" />
        <activity android:name=".PrintActivity" android:exported="false" android:theme="@style/ToolDrawerLight" />
        <activity android:name=".PrintJobsActivity" android:exported="false" />
    </application>
</manifest>
