<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <queries><package android:name="com.termux" /><intent><action android:name="android.speech.RecognitionService" /></intent></queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustNothing">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <activity android:name=".TopicsActivity" android:exported="false" android:theme="@style/ToolDrawerLight" />
        <activity android:name=".HistoryActivity" android:exported="false" />
        <activity android:name=".MemoryActivity" android:exported="false" />
        <activity android:name=".AssistantSettingsActivity" android:exported="false" />
        <service android:name=".GretaFirebaseMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver android:name=".ResultReceiver" android:exported="false" />
        <activity android:name=".SyncActivity" android:exported="false" android:theme="@style/ToolDrawerLight" />
        <activity android:name=".PrintActivity" android:exported="false" android:theme="@style/ToolDrawerLight" />
        <activity android:name=".PrintJobsActivity" android:exported="false" />
    </application>
</manifest>
