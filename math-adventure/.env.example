# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MATH_ADMIN_TOKEN=
MATH_BIND_ADDRESS=127.0.0.1
MATH_PORT=8788
MATH_TIMEZONE=Asia/Shanghai
# Set to /math if serving behind the supplied Nginx /math/ location.
MATH_ROOT_PATH=

# SMTP credentials belong only in the server .env; never commit a mail password.
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_SSL_ENABLED=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Optional allowlist. Empty: any verified email gets its own isolated user.
MATH_PARENT_EMAILS=
# auto: private IP over HTTP works on LAN; public domains keep Secure cookies.
# true: require HTTPS for all browser sessions; false: disable Secure explicitly.
MATH_COOKIE_SECURE=auto
