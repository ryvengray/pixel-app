# Copy this file to server/.env. Never commit the copied file.
# Public HTTPS address used inside the one-time pairing QR code.
GRAY_PUBLIC_BASE_URL=https://gray.example.com
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Docker Compose overrides DATABASE_PATH to its persistent /data volume.
DATABASE_PATH=./data/gray.db
# Put the JSON in server/private/, which is Git-ignored. Compose mounts it at this path.
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json

# Optional: compose.decision.yaml supplies DECISION_URL when routing is deployed.
# DECISION_URL=http://127.0.0.1:18081

# E1002 ink-screen service. With both services on the same Ubuntu host,
# greta-service's host network reaches ink-screen's published port here.
# For a different host, replace 127.0.0.1 with its reachable LAN address.
INK_API_BASE=http://127.0.0.1:18000
# Set to ink-screen's PIXEL_TOKEN. Blank disables scheduled sends.
INK_TOKEN=
INK_DEVICE_ID=desk-01
# Shanghai-time rotation is fixed at 06:00, 14:00 and 20:00.
# Compose overrides this with /ink-backgrounds (the host-mounted library).
# For a non-Docker launch, this path is relative to the working directory.
INK_GALLERY_DIR=./data/ink-backgrounds
INK_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# Optional weather location. Set city label AND decimal latitude/longitude.
# Blank coordinates show weather as unavailable instead of using a fake city.
INK_LOCATION=
INK_LATITUDE=
INK_LONGITUDE=

# Bypass Compose's HTTP proxy for same-host ink-screen requests.
# If ink-screen runs on another host, append that host's IP/name to BOTH lists.
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1
